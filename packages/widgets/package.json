{
  "name": "@phaser-mvvm/widgets",
  "version": "0.0.0",
  "description": "Widget library of phaser-mvvm: Panel, Label, TextField, TextArea, Button, ScrollView, Repeat, Modal",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2022 --external phaser",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@phaser-mvvm/core": "workspace:*",
    "@phaser-mvvm/layout": "workspace:*",
    "@phaser-mvvm/phaser": "workspace:*"
  },
  "peerDependencies": {
    "phaser": "^4.2.0"
  },
  "devDependencies": {
    "phaser": "4.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
